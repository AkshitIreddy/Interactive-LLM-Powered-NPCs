  "performance_phases": [
    {
      "id": "cold_load",
      "minimum_successful_samples": 20,
      "precondition": "fresh_worker_and_cold_model",
      "operation": "load",
      "required_metrics": [
        "duration_millis",
        "process_private_bytes_delta",
        "process_working_set_bytes_delta",
        "process_cpu_millis_delta",
        "dedicated_vram_bytes_delta",
        "shared_gpu_bytes_delta"
      ]
    },
    {
      "id": "warm_reload",
      "minimum_successful_samples": 20,
      "precondition": "verified_unload_then_same_pack_reload",
      "operation": "reload",
      "required_metrics": [
        "duration_millis",
        "process_private_bytes_delta",
        "process_cpu_millis_delta",
        "dedicated_vram_bytes_delta"
      ]
    },
    {
      "id": "single_face_inference",
      "minimum_successful_samples": 100,
      "precondition": "advancing_wgc_frames_with_exactly_one_rights_cleared_face",
      "operation": "infer",
      "required_metrics": [
        "duration_millis",
        "wgc_copy_millis",
        "mapping_open_and_hash_millis",
        "detection_millis",
        "alignment_and_embedding_millis",
        "process_cpu_millis_delta",
        "process_private_bytes_peak",
        "dedicated_vram_bytes_peak",
        "game_frame_time_millis"
      ]
    },
    {
      "id": "multi_face_inference",
      "minimum_successful_samples": 100,
      "precondition": "advancing_wgc_frames_with_two_to_eight_rights_cleared_faces",
      "operation": "infer",
      "required_metrics": [
        "face_count",
        "duration_millis",
        "process_cpu_millis_delta",
        "process_private_bytes_peak",
        "dedicated_vram_bytes_peak",
        "game_frame_time_millis"
      ]
    },
    {
      "id": "generation_cancel",
      "minimum_successful_samples": 20,
      "precondition": "inference_accepted_before_generation_advance",
      "operation": "cancel",
      "required_metrics": [
        "cancel_to_barrier_millis",
        "late_result_count",
        "worker_exit_count",
        "mapping_release_millis"
      ]
    },
    {
      "id": "unload",
      "minimum_successful_samples": 20,
      "precondition": "loaded_idle_worker",
      "operation": "unload",
      "required_metrics": [
        "duration_millis",
        "process_private_bytes_after",
        "process_working_set_bytes_after",
        "dedicated_vram_bytes_after"
      ]
    },
    {
      "id": "crash_restart",
      "minimum_successful_samples": 20,
      "precondition": "forced_worker_termination_with_active_or_idle_state",
      "operation": "restart",
      "required_metrics": [
        "restart_to_handshake_millis",
        "orphan_mapping_count",
        "stale_result_count",
        "crash_loop_suppression_state"
      ]
    }
  ],
