    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,ts}\" --ignore-unknown"
  },
  "dependencies": {
    "@react-aria/visually-hidden": "^3.8.28",
    "@tauri-apps/api": "^2.8.0",
