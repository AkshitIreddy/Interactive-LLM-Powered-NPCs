{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interactive NPCs Response Console",
  "version": "2.0.0-alpha.1",
  "identifier": "io.github.akshitireddy.interactive-npcs",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
      "freezePrototype": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Interactive NPCs — Response Console",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "focus": true,
        "devtools": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/npc-runtime",
      "binaries/npc-media-broker"
    ],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../../profiles/games/": "profiles/games/",
      "../../../catalog/v1/catalog.json": "catalog/v1/catalog.json",
      "../../../packaging/model-packs/": "packaging/model-packs/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
