{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "portable-tests",
      "displayName": "Portable policy tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/portable-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GAME_LOAD_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "portable-tests",
      "configurePreset": "portable-tests"
    }
  ],
  "testPresets": [
    {
      "name": "portable-tests",
      "configurePreset": "portable-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
