{
  "schema_version": 1,
  "distribution": "local-review-only",
  "require_clean_tests": true,
  "require_secret_scan": true,
  "require_sbom": true,
  "require_license_review": true,
  "require_artifact_sha256": true,
  "artifact_hash_algorithm": "SHA-256",
  "require_source_identity": true,
  "require_all_dependency_locks": true,
  "require_distribution_component_ledger": true,
  "require_artifact_scoped_sbom": true,
  "require_exact_license_material_corpus": true,
  "require_pinned_license_material_overrides": true,
  "require_extracted_installer_reconciliation": true,
  "require_review_test_game_reconciliation": true,
  "require_installed_legal_resources": true,
  "require_release_crt_import_audit": true,
  "forbid_debug_crt_imports": true,
  "forbid_unclassified_distribution_files": true,
  "forbid_ffmpeg_or_ffprobe_in_base_and_review_fixture": true,
  "require_reachable_history_secret_scan": true,
  "skip_checks_classification": "unchecked-development-package",
  "allow_publication": false,
  "allow_update_feed_activation": false,
  "allow_embedded_secrets": false,
  "allow_large_models_in_base_installer": false,
  "allow_system_python_dependency": false
}
